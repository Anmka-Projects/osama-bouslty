generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Users table - stores all system users (students, instructors, admins)
model User {
  id                         String                      @id @default(uuid())
  name                       String                      @db.VarChar(255)
  nameEn                     String?                     @map("name_en") @db.VarChar(255)
  email                      String?                     @unique @db.VarChar(255)
  phone                      String                      @unique @db.VarChar(20)
  parentPhone                String?                     @map("parent_phone") @db.VarChar(20)
  passwordHash               String                      @map("password_hash") @db.VarChar(255)
  avatar                     String?                     @db.VarChar(500)
  title                      String?                     @db.VarChar(255)
  titleEn                    String?                     @map("title_en") @db.VarChar(255)
  bio                        String?                     @db.Text
  bioEn                      String?                     @map("bio_en") @db.Text
  role                       UserRole                    @default(student)
  status                     UserStatus                  @default(pending)
  enrolledCoursesCount       Int                         @default(0) @map("enrolled_courses_count")
  studentType                StudentType?                @map("student_type")
  countryId                  String?                     @map("country_id")
  categoryId                 String?                     @map("category_id")
  subcategoryId              String?                     @map("subcategory_id")
  commissionType             CommissionType?             @default(none) @map("commission_type")
  commissionValue            Decimal?                    @map("commission_value") @db.Decimal(10, 2)
  totalEarnings              Decimal                     @default(0.00) @map("total_earnings") @db.Decimal(10, 2)
  joinedAt                   DateTime                    @default(now()) @map("joined_at")
  lastActive                 DateTime?                   @map("last_active")
  refreshToken               String?                     @map("refresh_token") @db.VarChar(500)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  appConfigUpdates           AppConfig[]                 @relation("AppConfigUpdatedBy")
  attendanceRecords          AttendanceRecord[]
  certificates               Certificate[]
  courseApprovals            CourseApproval[]            @relation("ReviewedBy")
  courses                    Course[]                    @relation("InstructorCourses")
  liveSessions               LiveSession[]               @relation("InstructorLiveSessions")
  notificationRecipients     NotificationRecipient[]
  payments                   Payment[]
  studentDebts               StudentDebt[]
  enrollments                UserCourseEnrollment[]
  enrollmentRequests         EnrollmentRequest[]
  examAttempts               UserExamAttempt[]
  lessonProgress             UserLessonProgress[]
  liveSessionEnrollments     UserLiveSessionEnrollment[]
  teacherSalarySettings      TeacherSalarySettings?      @relation("TeacherSalarySettings")
  attendanceRecordsAsTeacher AttendanceRecordExtended[]  @relation("AttendanceRecordTeacher")
  treasuryTransactions       TreasuryTransaction[]       @relation("TreasuryTransactionCreator")
  chatConversationsAs1       ChatConversation[]          @relation("ChatParticipant1")
  chatConversationsAs2       ChatConversation[]          @relation("ChatParticipant2")
  chatMessagesSent           ChatMessage[]               @relation("ChatMessageSender")
  country                    Country?                    @relation("UserCountry", fields: [countryId], references: [id])
  category                   Category?                   @relation("UserStage", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory                Category?                   @relation("UserGrade", fields: [subcategoryId], references: [id], onDelete: SetNull)
  studentActivities          StudentActivity[]           @relation("StudentActivities")
  videoWatchProgress         VideoWatchProgress[]        @relation("VideoWatchProgress")
  blockedAccounts            BlockedAccount[]            @relation("BlockedAccounts")
  securityAlerts             SecurityAlert[]             @relation("StudentSecurityAlerts")
  fcmDevices                 UserFcmDevice[]
  wishlists                  Wishlist[]
  activationCodesCreated     ActivationCode[]            @relation("ActivationCodeCreator")
  activationCodeRedemptions  ActivationCodeRedemption[]
  trainerProfile             TrainerProfile?
  studentSessionBookings     SessionBooking[]            @relation("StudentSessionBookings")
  trainerSessionBookings     SessionBooking[]            @relation("TrainerSessionBookings")
  bookingReviewsWritten      BookingReview[]             @relation("BookingReviewsWritten")
  payoutRequests             PayoutRequest[]
  earningLedger              TrainerEarningLedger[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([studentType], map: "idx_student_type")
  @@index([countryId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("users")
}

/// Registered FCM device tokens per user (Flutter / mobile push)
model UserFcmDevice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @db.VarChar(512)
  platform  String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("user_fcm_devices")
}

/// User wishlist items (student bookmarks)
model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("wishlists")
}

/// Categories table - course categories
/// parent_id NULL = top-level category; set = subcategory (one level deep only)
model Category {
  id           String     @id @default(uuid())
  name         String     @db.VarChar(255)
  description  String?    @db.Text
  icon         String     @db.VarChar(100)
  parentId     String?    @map("parent_id")
  coursesCount Int        @default(0) @map("courses_count")
  order        Int
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  courses      Course[]
  parent       Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryChildren")
  stageUsers   User[]     @relation("UserStage")
  gradeUsers   User[]     @relation("UserGrade")
  trainerSubjects TrainerSubject[] @relation("TrainerSubjectCategory")

  @@index([parentId])
  @@index([order])
  @@index([isActive])
  @@map("categories")
}

/// Countries table - for student country selection
model Country {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]   @relation("UserCountry")

  @@index([name])
  @@map("countries")
}

/// Currencies table - available currencies for course pricing
model Currency {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  symbol    String   @db.VarChar(20)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]

  @@index([isDefault])
  @@index([isActive])
  @@map("currencies")
}

/// Courses table - all courses in the system
model Course {
  id                     String                  @id @default(uuid())
  title                  String                  @db.VarChar(255)
  description            String                  @db.Text
  whatYouWillGet         Json?                   @map("what_you_will_get")
  thumbnail              String?                 @db.VarChar(500)
  price                  Decimal                 @default(0.00) @db.Decimal(10, 2)
  discountPrice          Decimal?                @map("discount_price") @db.Decimal(10, 2)
  level                  CourseLevel
  categoryId             String                  @map("category_id")
  instructorId           String                  @map("instructor_id")
  duration               Int                     @default(0)
  durationSeconds        Int                     @default(0) @map("duration_seconds")
  lessonsCount           Int                     @default(0) @map("lessons_count")
  studentsCount          Int                     @default(0) @map("students_count")
  rating                 Decimal                 @default(0.00) @db.Decimal(3, 2)
  ratingsCount           Int                     @default(0) @map("ratings_count")
  status                 CourseStatus            @default(draft)
  isFeatured             Boolean                 @default(false) @map("is_featured")
  /// When true: show on website landing only (hidden from mobile app catalogs). Default false = not on landing, visible in app.
  showOnLanding          Boolean                 @default(false) @map("show_on_landing")
  allowOfflineDownload   Boolean                 @default(false) @map("allow_offline_download")
  isFree                 Boolean                 @default(false) @map("is_free")
  isSkillTrackCourse     Boolean                 @default(false) @map("is_skill_track_course")
  skillTier              Int?                    @map("skill_tier")
  titleAr                String?                 @map("title_ar") @db.VarChar(255)
  skillTierLabelAr       String?                 @map("skill_tier_label_ar") @db.VarChar(255)
  skillTierLabelEn       String?                 @map("skill_tier_label_en") @db.VarChar(255)
  currencyId             String?                 @map("currency_id")
  certificateTemplateId  String?                 @map("certificate_template_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  attendanceRecords      AttendanceRecord[]
  certificateTemplates   CertificateTemplate[]
  certificates           Certificate[]
  certificateTemplate    CertificateTemplate?    @relation("CourseCertificateTemplate", fields: [certificateTemplateId], references: [id])
  approval               CourseApproval?
  lessons                CourseLesson[]
  ratings                CourseRating[]
  sections               CourseSection[]
  category               Category                @relation(fields: [categoryId], references: [id])
  instructor             User                    @relation("InstructorCourses", fields: [instructorId], references: [id])
  currency               Currency?               @relation(fields: [currencyId], references: [id])
  exams                  Exam[]
  payments               Payment[]               @relation("CoursePayments")
  studentDebts           StudentDebt[]
  enrollments            UserCourseEnrollment[]
  enrollmentRequests     EnrollmentRequest[]
  examAttempts           UserExamAttempt[]
  lessonProgress         UserLessonProgress[]
  lectures               CourseLecture[]         @relation("CourseLectures")
  videoAssignments       VideoCourseAssignment[] @relation("VideoCourseAssignments")
  liveSessions           LiveSession[]
  wishlists              Wishlist[]
  bundleIncludesAsParent CourseBundleInclude[]   @relation("BundleParentCourse")
  bundleIncludesAsChild  CourseBundleInclude[]   @relation("BundleIncludedCourse")
  activationCodes        ActivationCode[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@index([isFeatured])
  @@index([currencyId])
  @@index([certificateTemplateId])
  @@index([isSkillTrackCourse, skillTier])
  @@index([createdAt])
  @@map("courses")
}

/// Courses unlocked together when a parent course is purchased (admin-configured bundle).
model CourseBundleInclude {
  id               String   @id @default(uuid())
  parentCourseId   String   @map("parent_course_id")
  includedCourseId String   @map("included_course_id")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  parentCourse     Course   @relation("BundleParentCourse", fields: [parentCourseId], references: [id], onDelete: Cascade)
  includedCourse   Course   @relation("BundleIncludedCourse", fields: [includedCourseId], references: [id], onDelete: Cascade)

  @@unique([parentCourseId, includedCourseId])
  @@index([parentCourseId])
  @@map("course_bundle_includes")
}

/// Course Sections - organize lessons within courses
model CourseSection {
  id        String         @id @default(uuid())
  courseId  String         @map("course_id")
  title     String         @db.VarChar(255)
  order     Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  lessons   CourseLesson[]
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
  @@map("course_sections")
}

/// Course Lessons - individual lessons within sections
model CourseLesson {
  id                 String               @id @default(uuid())
  sectionId          String               @map("section_id")
  courseId           String               @map("course_id")
  title              String               @db.VarChar(255)
  type               LessonType
  duration           Int?
  durationSeconds    Int?                 @default(0) @map("duration_seconds")
  content            String?              @db.Text
  videoUrl           String?              @map("video_url") @db.VarChar(500)
  fileUrl            String?              @map("file_url") @db.VarChar(500)
  databankResourceId String?              @map("databank_resource_id")
  isFree             Boolean              @default(false) @map("is_free")
  order              Int
  examId             String?              @map("exam_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section            CourseSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  exam               Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  databankResource   DatabankResource?    @relation(fields: [databankResourceId], references: [id], onDelete: SetNull)
  progress           UserLessonProgress[]

  @@index([sectionId])
  @@index([courseId])
  @@index([order])
  @@index([examId])
  @@index([databankResourceId])
  @@map("course_lessons")
}

/// Course Lectures - standalone lectures for courses (separate from curriculum)
model CourseLecture {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  youtubeUrl  String   @map("youtube_url") @db.VarChar(500)
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  course      Course   @relation("CourseLectures", fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
  @@map("course_lectures")
}

/// User Course Enrollment - tracks user enrollments in courses
model UserCourseEnrollment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  isActive    Boolean   @default(true) @map("is_active")
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([progress])
  @@map("user_course_enrollments")
}

/// Enrollment Request - pending enrollment requests awaiting admin approval
model EnrollmentRequest {
  id              String                  @id @default(uuid())
  userId          String                  @map("user_id")
  courseId        String                  @map("course_id")
  /// When set, this request is for a single lesson/live session inside the course
  /// (item_type = "lesson"). Null means a whole-course request.
  liveSessionId   String?                 @map("live_session_id")
  message         String?                 @db.Text
  paymentMethod   String?                 @map("payment_method") @db.VarChar(30)
  /// مسار أو رابط صورة إيصال الدفع (مطلوب لطريقة المكتبة)
  receiptImageUrl String?                 @map("receipt_image_url") @db.VarChar(1024)
  status          EnrollmentRequestStatus @default(pending)
  adminNotes      String?                 @map("admin_notes") @db.Text
  reviewedBy      String?                 @map("reviewed_by")
  reviewedAt      DateTime?               @map("reviewed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  liveSession     LiveSession?            @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([liveSessionId])
  @@index([status])
  @@map("enrollment_requests")
}

enum EnrollmentRequestStatus {
  pending
  approved
  rejected
}

/// User Lesson Progress - tracks user progress in individual lessons
model UserLessonProgress {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  lessonId        String       @map("lesson_id")
  courseId        String       @map("course_id")
  isCompleted     Boolean      @default(false) @map("is_completed")
  watchedDuration Int          @default(0) @map("watched_duration")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson          CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([courseId])
  @@map("user_lesson_progress")
}

/// Course Ratings - user ratings for courses
model CourseRating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  review    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_ratings")
}

/// Exams table - course exams
model Exam {
  id                String            @id @default(uuid())
  courseId          String            @map("course_id")
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  questionsCount    Int               @default(0) @map("questions_count")
  passingScore      Int               @map("passing_score")
  maxAttempts       Int               @default(1) @map("max_attempts")
  duration          Int
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  questions         ExamQuestion[]
  items             ExamItem[]
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts          UserExamAttempt[]
  curriculumLessons CourseLesson[]

  @@index([courseId])
  @@index([isActive])
  @@map("exams")
}

/// Exam Questions - questions within exams (legacy; new exams use ExamItem + DatabankItem)
model ExamQuestion {
  id            String       @id @default(uuid())
  examId        String       @map("exam_id")
  text          String       @db.Text
  type          QuestionType
  options       String?      @db.LongText
  correctAnswer String       @map("correct_answer") @db.VarChar(500)
  points        Int          @default(1)
  order         Int
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([order])
  @@map("exam_questions")
}

/// Databank Topics - hierarchical topic tree for categorizing items and resources
model DatabankTopic {
  id        String                  @id @default(uuid())
  name      String                  @db.VarChar(255)
  parentId  String?                 @map("parent_id")
  order     Int                     @default(0)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  parent    DatabankTopic?          @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  DatabankTopic[]         @relation("TopicHierarchy")
  items     DatabankItemTopic[]
  resources DatabankResourceTopic[]

  @@index([parentId])
  @@index([order])
  @@map("databank_topics")
}

/// Databank Items - central reusable library of questions/resources
model DatabankItem {
  id            String              @id @default(uuid())
  title         String              @db.VarChar(255)
  content       String              @db.LongText
  type          DatabankItemType
  options       String?             @db.LongText
  correctAnswer String?             @map("correct_answer") @db.VarChar(500)
  solution      String?             @db.Text
  hints         String?             @db.Text
  difficulty    Difficulty?
  outcomeCode   String?             @map("outcome_code") @db.VarChar(100)
  tags          String?             @db.VarChar(500)
  status        DatabankItemStatus  @default(draft)
  version       Int                 @default(1)
  usageCount    Int                 @default(0) @map("usage_count")
  lastUsedAt    DateTime?           @map("last_used_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  topics        DatabankItemTopic[]
  examItems     ExamItem[]

  @@index([type])
  @@index([status])
  @@index([difficulty])
  @@index([outcomeCode])
  @@index([createdAt])
  @@index([lastUsedAt])
  @@map("databank_items")
}

/// Pivot: DatabankItem <-> DatabankTopic (many-to-many)
model DatabankItemTopic {
  itemId  String        @map("item_id")
  topicId String        @map("topic_id")
  item    DatabankItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topic   DatabankTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([itemId, topicId])
  @@index([topicId])
  @@map("databank_item_topics")
}

/// Databank Resources - central reusable library of media files (PDF, video, etc.)
/// Upload once, reuse across multiple course curriculum sections
model DatabankResource {
  id          String                  @id @default(uuid())
  title       String                  @db.VarChar(255)
  type        DatabankResourceType
  fileUrl     String                  @map("file_url") @db.VarChar(500)
  fileSize    Int?                    @map("file_size")
  mimeType    String?                 @map("mime_type") @db.VarChar(100)
  description String?                 @db.Text
  usageCount  Int                     @default(0) @map("usage_count")
  lastUsedAt  DateTime?               @map("last_used_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  topics      DatabankResourceTopic[]
  lessons     CourseLesson[]

  @@index([type])
  @@index([createdAt])
  @@index([lastUsedAt])
  @@map("databank_resources")
}

/// Pivot: DatabankResource <-> DatabankTopic (many-to-many)
model DatabankResourceTopic {
  resourceId String           @map("resource_id")
  topicId    String           @map("topic_id")
  resource   DatabankResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic      DatabankTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([resourceId, topicId])
  @@index([topicId])
  @@map("databank_resource_topics")
}

/// Exam Items - links exams to databank items (reference or copy mode)
model ExamItem {
  id              String        @id @default(uuid())
  examId          String        @map("exam_id")
  databankItemId  String?       @map("databank_item_id")
  snapshotJson    String?       @map("snapshot_json") @db.LongText
  points          Int           @default(1)
  order           Int
  databankVersion Int?          @map("databank_version")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  exam            Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  databankItem    DatabankItem? @relation(fields: [databankItemId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([databankItemId])
  @@index([order])
  @@map("exam_items")
}

/// User Exam Attempts - tracks user attempts at exams
model UserExamAttempt {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  examId              String    @map("exam_id")
  courseId            String    @map("course_id")
  score               Decimal?  @db.Decimal(5, 2)
  percentage          Decimal?  @db.Decimal(5, 2)
  isPassed            Boolean?  @map("is_passed")
  /// Set when submitted — for mobile list (correct vs wrong counts)
  correctAnswersCount Int?      @map("correct_answers_count")
  wrongAnswersCount   Int?      @map("wrong_answers_count")
  answers             String    @db.LongText
  durationMinutes     Int?      @map("duration_minutes")
  startedAt           DateTime  @default(now()) @map("started_at")
  submittedAt         DateTime? @map("submitted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam                Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@index([courseId])
  @@map("user_exam_attempts")
}

/// Live Sessions table
model LiveSession {
  id            String                      @id @default(uuid())
  title         String                      @db.VarChar(255)
  description   String?                     @db.Text
  courseId      String?                     @map("course_id")
  instructorId  String                      @map("instructor_id")
  platform      Platform
  platformLink  String                      @map("platform_link") @db.VarChar(500)
  scheduledAt   DateTime                    @map("scheduled_at")
  duration      Int
  capacity      Int
  enrolledCount Int                         @default(0) @map("enrolled_count")
  price         Decimal                     @default(0.00) @db.Decimal(10, 2)
  status        LiveSessionStatus           @default(scheduled)
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")
  course        Course?                     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  instructor    User                        @relation("InstructorLiveSessions", fields: [instructorId], references: [id])
  payments      Payment[]                   @relation("LiveSessionPayments")
  enrollments   UserLiveSessionEnrollment[]
  enrollmentRequests EnrollmentRequest[]

  @@index([instructorId])
  @@index([courseId])
  @@index([scheduledAt])
  @@index([status])
