/// Chat: 1-1 conversations between admin/teacher and student
model ChatModerationAlert {
  id             String   @id @db.VarChar(36)
  conversationId String?  @map("conversation_id") @db.VarChar(36)
  senderId       String   @map("sender_id") @db.VarChar(36)
  originalBody   String   @map("original_body") @db.Text
  cleanedBody    String?  @map("cleaned_body") @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([senderId])
  @@index([createdAt])
  @@map("chat_moderation_alerts")
}

model ChatConversation {
  id             String        @id @default(uuid()) @db.VarChar(36)
  participant1Id String        @map("participant1_id") @db.VarChar(36)
  participant2Id String        @map("participant2_id") @db.VarChar(36)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(0)
  participant1   User          @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User          @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.VarChar(36)
  conversationId String           @map("conversation_id") @db.VarChar(36)
  senderId       String           @map("sender_id") @db.VarChar(36)
  body           String           @db.Text
  attachmentUrl  String?          @map("attachment_url") @db.Text
  attachmentType String?          @map("attachment_type") @db.VarChar(20)
  attachmentName String?          @map("attachment_name") @db.VarChar(255)
  attachmentSize Int?             @map("attachment_size")
  durationSeconds Int?            @map("duration_seconds")
  readAt         DateTime?        @map("read_at") @db.DateTime(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

/// Student Activities - tracks student activities (video views, logins, exam attempts)
model StudentActivity {
  id                String   @id @default(uuid()) @db.VarChar(36)
  studentId         String   @map("student_id") @db.VarChar(36)
  activityType      String   @map("activity_type") @db.VarChar(50)
  videoId           String?  @map("video_id") @db.VarChar(36)
  examId            String?  @map("exam_id") @db.VarChar(36)
  timestamp         DateTime @default(now()) @db.DateTime(0)
  sessionId         String?  @map("session_id") @db.VarChar(255)
  deviceFingerprint String?  @map("device_fingerprint") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  student           User     @relation("StudentActivities", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, timestamp])
  @@index([activityType])
  @@index([timestamp])
  @@map("student_activities")
}

/// Video - standalone videos that can be assigned to multiple courses
model Video {
  id                String                  @id @default(uuid()) @db.VarChar(36)
  title             String                  @db.VarChar(255)
  url               String                  @db.VarChar(500)
  sourceType        String?                 @map("source_type") @db.VarChar(50)
  sourceId          String?                 @map("source_id") @db.VarChar(36)
  createdAt         DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.DateTime(0)
  courseAssignments VideoCourseAssignment[] @relation("VideoCourseAssignments")

  @@index([sourceType, sourceId])
  @@map("videos")
}

/// Video Course Assignments - many-to-many: videos can be in multiple courses
model VideoCourseAssignment {
  id         String   @id @default(uuid()) @db.VarChar(36)
  videoId    String   @map("video_id") @db.VarChar(36)
  courseId   String   @map("course_id") @db.VarChar(36)
  assignedBy String?  @map("assigned_by") @db.VarChar(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(0)
  course     Course   @relation("VideoCourseAssignments", fields: [courseId], references: [id], onDelete: Cascade)
  video      Video    @relation("VideoCourseAssignments", fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, courseId])
  @@index([videoId])
  @@index([courseId])
  @@map("video_course_assignments")
}

/// Video Watch Progress - tracks student video viewing (videoId can be Video.id, CourseLesson.id, or CourseLecture.id)
model VideoWatchProgress {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  studentId             String   @map("student_id") @db.VarChar(36)
  videoId               String   @map("video_id") @db.VarChar(36)
  watchCount            Int      @default(1) @map("watch_count")
  completionPercentage  Decimal? @map("completion_percentage") @db.Decimal(5, 2)
  lastWatchedAt         DateTime @default(now()) @map("last_watched_at") @db.DateTime(0)
  totalWatchTimeSeconds Int?     @map("total_watch_time_seconds")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  student               User     @relation("VideoWatchProgress", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
  @@map("video_watch_progress")
}

/// Blocked Accounts - security violations (screen capture, multiple devices)
model BlockedAccount {
  id               String    @id @default(uuid()) @db.VarChar(36)
  studentId        String    @map("student_id") @db.VarChar(36)
  violationType    String    @map("violation_type") @db.VarChar(50)
  violationDetails String?   @map("violation_details") @db.Text
  blockedAt        DateTime  @default(now()) @map("blocked_at") @db.DateTime(0)
  blockedBy        String    @default("system") @map("blocked_by") @db.VarChar(50)
  isActive         Boolean   @default(true) @map("is_active")
  unblockedAt      DateTime? @map("unblocked_at") @db.DateTime(0)
  unblockedBy      String?   @map("unblocked_by") @db.VarChar(36)
  student          User      @relation("BlockedAccounts", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([violationType])
  @@index([blockedAt])
  @@index([isActive])
  @@map("blocked_accounts")
}

/// Security Alerts - repeated multi-device attempts for admin review workflow
model SecurityAlert {
  id           String   @id @default(uuid()) @db.VarChar(36)
  studentId    String   @map("student_id") @db.VarChar(36)
  type         String   @default("multiple_devices") @db.VarChar(50)
  status       String   @default("new") @db.VarChar(30)
  severity     String   @default("high") @db.VarChar(20)
  attemptCount Int      @default(1) @map("attempt_count")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at") @db.DateTime(0)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.DateTime(0)
  evidenceJson String?  @map("evidence_json") @db.LongText
  assignedTo   String?  @map("assigned_to") @db.VarChar(36)
  reviewNote   String?  @map("review_note") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  student      User     @relation("StudentSecurityAlerts", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, lastSeenAt])
  @@index([studentId, lastSeenAt])
  @@index([type, lastSeenAt])
  @@map("security_alerts")
}

enum TrainerVerificationStatus {
  draft
  pending
  approved
  rejected
  suspended
}

enum TrainerOfferingType {
  single_session
  package
  course
}

enum SessionBookingStatus {
  requested
  pending_payment
  confirmed
  scheduled
  live
  completed
  cancelled
}

enum SessionPaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum MeetingProviderKind {
  teams
  zoom
  jitsi
  custom_web
}

enum LedgerEntryType {
  credit
  debit
  refund
}

enum PayoutRequestStatus {
