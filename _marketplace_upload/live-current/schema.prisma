/// User Live Session Enrollment
model UserLiveSessionEnrollment {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  liveSessionId String      @map("live_session_id")
  enrolledAt    DateTime    @default(now()) @map("enrolled_at")
  attended      Boolean     @default(false)
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, liveSessionId])
  @@index([userId])
  @@index([liveSessionId])
  @@map("user_live_session_enrollments")
}

/// Payments table - all payment transactions
/// NOTE: item_id is polymorphic (course | subscription | live_session). The DB-level
/// FKs payments_course_fk / payments_live_session_fk were dropped intentionally —
/// together they made every insert impossible. Keep both relations declared below
/// (payment.course / payment.liveSession queries depend on them); integrity of
/// item_id is enforced in application code. Do NOT re-add both physical FKs.
model Payment {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("ج.م") @db.VarChar(10)
  method         PaymentMethod
  status         PaymentStatus   @default(pending)
  itemType       PaymentItemType @map("item_type")
  itemId         String          @map("item_id")
  itemName       String          @map("item_name") @db.VarChar(255)
  transactionId  String?         @map("transaction_id") @db.VarChar(255)
  paymentGateway String?         @map("payment_gateway") @db.VarChar(50)
  couponId       String?         @map("coupon_id")
  couponDiscount Decimal?        @map("coupon_discount") @db.Decimal(10, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  coupon         Coupon?         @relation(fields: [couponId], references: [id])
  course         Course?         @relation("CoursePayments", fields: [itemId], references: [id], map: "payments_course_fk")
  liveSession    LiveSession?    @relation("LiveSessionPayments", fields: [itemId], references: [id], map: "payments_live_session_fk")
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([itemType])
  @@index([createdAt])
  @@index([couponId], map: "payments_coupon_id_fkey")
  @@index([itemId], map: "payments_live_session_fk")
  @@map("payments")
}

/// Coupons table - discount coupons
model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(50)
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  maxUses     Int?       @map("max_uses")
  usedCount   Int        @default(0) @map("used_count")
  minPurchase Decimal    @default(0.00) @map("min_purchase") @db.Decimal(10, 2)
  expiresAt   DateTime?  @map("expires_at")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  payments    Payment[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

/// Activation Codes - course-bound codes that unlock a course for free on redeem
model ActivationCode {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(50)
